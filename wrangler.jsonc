{
  "name": "the-baby",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "vars": {
    "REVEAL_GENDER": "boy",
    "PUBLIC_SITE_URL": "https://the-baby.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "REACTIONS",
      "bucket_name": "the-baby-reactions"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "the-baby",
      "database_id": "0db03421-94d9-4f51-9c1f-572907c66d93"
    }
  ]
}
