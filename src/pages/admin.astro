---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Reações — Our Little Star"><main style="max-width:760px;margin:12vh auto;padding:24px"><h1>Memórias da nossa estrela</h1><p>Use seu token privado para visualizar as reações enviadas.</p><form id="form"><input id="token" type="password" placeholder="Token de administrador" required style="padding:14px;border-radius:10px;width:70%;max-width:400px"/><button style="padding:14px">Entrar</button></form><div id="results"></div></main><script>document.querySelector('#form')?.addEventListener('submit',async e=>{e.preventDefault();const token=(document.querySelector('#token') as HTMLInputElement).value;const res=await fetch('/api/admin/reactions',{headers:{Authorization:'Bearer '+token}});const area=document.querySelector('#results')!;area.replaceChildren();if(!res.ok){area.textContent='Acesso negado ou armazenamento ainda não configurado.';return}const data=await res.json();for(const record of data.reactions){const entry=document.createElement('article');entry.style.cssText='padding:18px;margin-top:16px;border:1px solid #ffffff30;border-radius:12px';const label=document.createElement('p');label.textContent=record.name+' — palpite: '+record.guess+' — '+new Date(record.created_at).toLocaleString('pt-BR');entry.append(label);const a=document.createElement('a');a.href='/api/admin/video/'+encodeURIComponent(record.id);a.textContent='Assistir ao vídeo';a.target='_blank';a.rel='noopener noreferrer';a.addEventListener('click',e=>{e.preventDefault();fetch(a.href,{headers:{Authorization:'Bearer '+token}}).then(r=>{if(!r.ok)throw Error('Falha ao carregar');return r.blob()}).then(b=>{const url=URL.createObjectURL(b);const v=document.createElement('video');v.src=url;v.controls=true;v.playsInline=true;v.style.maxWidth='100%';entry.append(v);v.play().catch(()=>{});v.addEventListener('emptied',()=>URL.revokeObjectURL(url),{once:true})}).catch(()=>{a.textContent='Não foi possível abrir'});});entry.append(a);area.append(entry)}});</script></Layout>
